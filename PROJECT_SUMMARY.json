  "usage": {
    "installation": "npm install",
    "build": "npm run build",
    "watch": "npm run dev",
    "storybook": "npm run storybook"
  },

  "example-import": {
    "tokens": "import { colors, spacing, typography } from '@societyhub/design-tokens'",
    "components": "import { Button, Card, Input, Badge } from '@societyhub/ui-components'"
  },

