  "pages-ready-to-build": {
    "authentication": [
      "Login Screen - Email/Password input, sign-in button",
      "Registration - Multi-step form with validation",
      "OTP Verification - PIN input, timer",
      "Password Reset - Email verification flow"
    ],
    "dashboard": [
      "Resident Dashboard - Quick stats, recent payments/complaints",
      "Committee Dashboard - Overview metrics, pending approvals",
      "Admin Dashboard - System stats, user management access"
    ],
    "financial": [
      "Payment Screen - Method selection, amount, confirmation",
      "Invoice View - Detailed breakdown, download option",
      "Payment History - Paginated table, filters",
      "Collection Report - Admin view with analytics"
    ],
    "complaints": [
      "Complaint Form - Type selection, description, attachment",
      "Complaint List - Status filtering, search, sort",
      "Complaint Details - Timeline, status updates, comments",
      "Committee Review - Approve/reject interface"
    ],
    "notices": [
      "Notice Board - Latest notices, categorized",
      "Notice Detail - Full content, acknowledgment",
      "Notice History - Archived notices, search",
      "Publish Notice - Admin form for creating"
    ],
    "documents": [
      "Document Library - Browse, search, download",
      "Upload Document - Drag-drop, type selection",
      "Document Viewer - Preview, download, share",
      "Document Management - Admin: organize, permissions"
    ]
