{
  "project": "SocietyHub Design System",
  "description": "Enterprise-grade Housing Society Management SaaS - Complete React component library and design tokens",
  "version": "1.0.0",
  "status": "Production Ready",
  "repository": "pawyogesh/test",
  "created": "2026-06-07",
  
  "structure": {
    "root": {
      "package.json": "Monorepo workspace configuration",
      "README.md": "Project overview",
      "docs/": "Documentation folder"
    },
    "packages/design-tokens": {
      "description": "Centralized design tokens",
      "files": {
        "package.json": "Package configuration",
        "tokens.json": "JSON design tokens",
        "src/index.ts": "TypeScript exports",
        "README.md": "Token documentation"
      }
    },
    "packages/ui-components": {
      "description": "React component library",
      "files": {
        "package.json": "Package configuration",
        "README.md": "Component guide",
        "src/": {
          "Button": "Primary UI element - 4 variants, 3 sizes",
          "Card": "Container component - elevated/outline",
          "Input": "Form input - with validation",
          "Badge": "Status indicator - 6 variants",
          "Tabs": "Tab navigation - controlled state",
          "Modal": "Dialog overlay - 3 sizes",
          "Table": "Data table - sortable columns",
          "Dropdown": "Menu component - click handling",
          "Alert": "Notification - 4 status types",
          "Avatar": "User profile - circle/square",
          "Layouts/": {
            "DashboardLayout": "Main layout with sidebar"
          },
          "Dashboard/": {
            "StatCard": "Metrics widget with trends"
          },
          "Payment/": {
            "PaymentMethod": "Payment option selector"
          },
          "Complaint/": {
            "StatusBadge": "Status indicator for tickets"
          },
          "index.ts": "Main export file"
        }
      }
    },
    "docs/": {
      "design-system.md": "Comprehensive design guidelines"
    }
  },

  "components": {
    "primitives": [
      "Button",
      "Card",
      "Input",
      "Badge",
      "Avatar",
      "Alert"
    ],
    "navigation": [
      "Tabs",
      "Modal",
      "Dropdown",
      "DashboardLayout"
    ],
    "data": [
      "Table"
    ],
    "domain-specific": [
      "StatCard",
      "PaymentMethod",
      "StatusBadge"
    ]
  },

  "design-tokens": {
    "colors": {
      "primary": "Blue #2563EB - Main brand color",
      "secondary": "Teal #14B8A6 - Accent",
      "success": "Green #22C55E - Positive",
      "warning": "Amber #F59E0B - Caution",
      "danger": "Red #EF4444 - Error",
      "neutral": "Gray scale - Text & backgrounds"
    },
    "typography": {
      "fontFamily": "Inter (base), Fira Code (mono)",
      "sizes": "xs (12px) to 4xl (36px)",
      "weights": "300-700 (light to bold)",
      "lineHeights": "1.25, 1.5, 1.75"
    },
    "spacing": {
      "base": "4px",
      "scale": "0, 4, 8, 12, 16, 20, 24, 32, 40, 48, 64, 80 (px)"
    },
    "borderRadius": {
      "scale": "none, sm (4px), base (6px), md (8px), lg (12px), xl (16px), full (9999px)"
    },
    "shadows": {
      "levels": "sm, base, md, lg, xl, 2xl"
    },
    "breakpoints": {
      "mobile": "320px",
      "tablet": "768px",
      "desktop": "1024px",
      "desktopLarge": "1280px",
      "desktopXL": "1536px"
    }
  },

  "features": {
    "accessibility": [
      "WCAG AA compliant",
      "Keyboard navigation",
      "Screen reader friendly",
      "Sufficient contrast ratios"
    ],
    "responsiveness": [
      "Mobile-first approach",
      "All screen sizes supported",
      "Touch-friendly controls",
      "Adaptive layouts"
    ],
    "developer": [
